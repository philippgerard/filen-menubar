{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Filen Menubar",
  "version": "0.1.33",
  "identifier": "io.filen.menubar",
  "build": {
    "beforeDevCommand": {
      "script": "bash scripts/build-filen-cli.sh",
      "cwd": "..",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "bash scripts/build-filen-cli.sh",
      "cwd": ".."
    },
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm"],
    "category": "Utility",
    "publisher": "Philipp Gerard",
    "copyright": "Copyright (c) 2025 Philipp Gerard",
    "license": "MIT AND AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "generated/filen-cli": "filen-cli",
      "generated/licenses/filen-cli": "licenses/filen-cli",
      "../LICENSE": "licenses/filen-menubar/MIT.txt",
      "../third-party/filen-cli/AGPL-3.0.txt": "licenses/filen-cli/AGPL-3.0.txt",
      "../third-party/filen-cli/README.md": "licenses/filen-cli/README.md"
    },
    "shortDescription": "A lightweight menubar app for Filen cloud sync",
    "longDescription": "Filen Menubar is a lightweight system tray application with an app-owned, patched Filen CLI backend for sync status monitoring.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "files": {
        "Helpers/filen-menubar-cli": "generated/filen-cli-node"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/lib/Filen Menubar/filen-cli/node": "generated/filen-cli-node"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/Filen Menubar/filen-cli/node": "generated/filen-cli-node"
        }
      }
    }
  }
}
