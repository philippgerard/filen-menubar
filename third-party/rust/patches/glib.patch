+
+    // Run this with --release: the immutable out-pointer in RUSTSEC-2024-0429
+    // was miscompiled under optimization. Cover every path through impl_get.
+    #[test]
+    fn test_variant_str_iter_mutable_out_pointer() {
+        let strings = vec!["first", "λast", ""];
+        let variant = strings.to_variant();
+
+        assert_eq!(
+            variant.array_iter_str().unwrap().collect::<Vec<_>>(),
+            strings
+        );
+        assert_eq!(
+            variant.array_iter_str().unwrap().rev().collect::<Vec<_>>(),
+            vec!["", "λast", "first"]
+        );
+        assert_eq!(variant.array_iter_str().unwrap().nth(1), Some("λast"));
+        assert_eq!(variant.array_iter_str().unwrap().nth_back(1), Some("λast"));
+        assert_eq!(variant.array_iter_str().unwrap().last(), Some(""));
+
+        let mut mixed = variant.array_iter_str().unwrap();
+        assert_eq!(mixed.next(), Some("first"));
+        assert_eq!(mixed.next_back(), Some(""));
+        assert_eq!(mixed.next(), Some("λast"));
+        assert_eq!(mixed.next_back(), None);
+        assert_eq!(mixed.next(), None);
+    }
+}
