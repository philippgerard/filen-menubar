diff --git a/src/app/featureInterfaces/syncInterface.test.ts b/src/app/featureInterfaces/syncInterface.test.ts
new file mode 100644
index 0000000..ac45711
--- /dev/null
+++ b/src/app/featureInterfaces/syncInterface.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, test } from "bun:test"
+import { mkdtemp, readFile, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { SyncMessage, SyncPair } from "@filen/sync/dist/types"
+import { buildF, EmptyX } from "../../framework/features"
+import { mockInterfaceAdapter } from "../../test/tests"
+import { outputVerboseSyncMessage, shouldOutputVerboseSyncMessage } from "./syncInterface"
+
+const syncPair = {
+	name: "test",
+	uuid: "00000000-0000-0000-0000-000000000001",
+	localPath: "/tmp/test",
+	remotePath: "/",
+	remoteParentUUID: "00000000-0000-0000-0000-000000000002",
+	mode: "twoWay",
+	paused: false,
+	excludeDotFiles: false,
+	localTrashDisabled: false,
+} satisfies SyncPair
+
+describe("shouldOutputVerboseSyncMessage()", () => {
+	test("omits ignored-tree payloads but outputs ordinary events without file logging", () => {
+		const output: string[] = []
+		const app = {
+			isFileLoggingEnabled: false,
+			outVerbose: (message: string) => output.push(message),
+		}
+
+		outputVerboseSyncMessage(app, { type: "localTreeIgnored", syncPair, data: { ignored: [] } })
+		outputVerboseSyncMessage(app, { type: "remoteTreeIgnored", syncPair, data: { ignored: [] } })
+		outputVerboseSyncMessage(app, { type: "cycleSuccess", syncPair })
+
+		expect(output).toHaveLength(1)
+		expect(output[0]).toContain("\"type\": \"cycleSuccess\"")
+		expect(shouldOutputVerboseSyncMessage({ type: "localTreeIgnored" }, true)).toBe(true)
+		expect(shouldOutputVerboseSyncMessage({ type: "remoteTreeIgnored" }, true)).toBe(true)
+	})
+
+	test("explicit log file captures ordinary and ignored diagnostics", async () => {
+		const directory = await mkdtemp(join(tmpdir(), "filen-cli-log-test-"))
+		const logFile = join(directory, "filen.log")
+
+		try {
+			const f = buildF<EmptyX>()
+			const { adapter, output } = mockInterfaceAdapter({ input: [] })
+			const emitDiagnostics = f.feature({
+				cmd: ["emit-diagnostics"],
+				description: null,
+				invoke: async ({ app }) => {
+					const messages: SyncMessage[] = [
+						{ type: "cycleSuccess", syncPair },
+						{ type: "localTreeIgnored", syncPair, data: { ignored: [] } },
+						{ type: "remoteTreeIgnored", syncPair, data: { ignored: [] } },
+					]
+
+					for (const message of messages) outputVerboseSyncMessage(app, message)
+					await new Promise(resolve => setTimeout(resolve, 0))
+				},
+			})
+			const app = f.app({
+				info: { name: "Test", version: "0.0.0" },
+				argv: ["--log-file", logFile, "emit-diagnostics"],
+				adapter,
+				features: [emitDiagnostics],
+				defaultCtx: {},
+				mainFeature: { cmd: [], description: null, arguments: [], invoke: async () => {} },
+			}).app()
+
+			expect(await app.main()).toBe(true)
+			expect(output()).toBe("")
+			const log = await readFile(logFile, "utf8")
+			expect(log).toContain("\"type\": \"cycleSuccess\"")
+			expect(log).toContain("\"type\": \"localTreeIgnored\"")
+			expect(log).toContain("\"type\": \"remoteTreeIgnored\"")
+		} finally {
+			await rm(directory, { recursive: true, force: true })
+		}
+	})
+})
